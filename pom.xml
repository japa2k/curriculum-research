<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.luccastk</groupId>
    <artifactId>job-search</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>job-search</name>
    <description>Fetches LinkedIn job postings from the public guest endpoint and serves them as JSON</description>

    <properties>
        <java.version>21</java.version>
        <jsoup.version>1.23.2</jsoup.version>
        <wiremock.version>3.13.2</wiremock.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests never see the engineer's real .env, and may write their own here. -->
                    <workingDirectory>${project.build.directory}/test-workdir</workingDirectory>
                    <environmentVariables>
                        <!-- Proves real environment variables take precedence over .env. -->
                        <TELEGRAM_CHAT_ID>chat-from-environment</TELEGRAM_CHAT_ID>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
